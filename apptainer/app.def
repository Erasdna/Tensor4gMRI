Bootstrap: docker
From: ubuntu:22.04

# Dependencies only: the repo's code is bind-mounted at run time
# (code/scripts/common.sh: --bind $PROJECT_DIR:/mnt/project, PYTHONPATH=/mnt/project/code).
# Build from the repo root: apptainer build apptainer/app.sif apptainer/app.def

%files
    pyproject.toml /opt/app/pyproject.toml
    uv.lock /opt/app/uv.lock

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        gnupg \
        git \
        build-essential \
        g++ \
        curl \
        ca-certificates \
        rsync \
        hdf5-tools \
        sqlite3 \
        && rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" INSTALLER_NO_MODIFY_PATH=1 sh

    # --frozen: exactly uv.lock; --no-install-project: the code is mounted, not installed
    cd /opt/app
    uv sync --frozen --no-cache --no-install-project

%environment
    # The venv's bin provides python and the gmri command line
    export VIRTUAL_ENV=/opt/app/.venv
    export PATH="/opt/app/.venv/bin:$PATH"
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec python "$@"
